# =================================  FLOW  =================================
# Repeats one email on purpose, so the import shows a failure (HTTP 409) for one contact.
FLOW_INCLUDE_DUPLICATE_EMAIL=true

# Hard limit of contacts generated in one run.
MAX_CONTACTS_PER_RUN=10

# Amount of contacts to be generated when the kickoff has no `count`.
FLOW_DEFAULT_COUNT=3

# =================================  BACKEND  =================================
# Where the External App backend runs. The flow creates the selected contacts here (POST /api/v1/contacts).
# Locally, localhost works. On CrewAI AMP it does NOT (localhost is the flow's own container): set this
# variable in the deployment to the public (ngrok) address of the backend, e.g. https://<something>.ngrok-free.app
EXTERNAL_APP_API_URL=http://localhost:8000
# EXTERNAL_APP_API_URL=https://<something>.ngrok-free.app
