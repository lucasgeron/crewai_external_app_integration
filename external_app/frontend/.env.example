# ================================= FRONTEND ================================= 
# Port of the frontend. Used by ../../dev.sh (Next.js itself does not read this variable).
FRONTEND_PORT=3000

# =================================  BACKEND ================================= 
# Where to find the External App API (the contacts backend). The browser calls it, and AMP calls it too (the
# webhooks of each run: the review request and the start and the end of the run), so after deploying the flow
# to AMP, set the PUBLIC address of the backend here (your ngrok tunnel, e.g. https://<id>.ngrok-free.app).
# With http://localhost:8000 the page loads, but AMP cannot reach it, and a kickoff is refused.
# It is the same address as EXTERNAL_APP_API_URL on AMP (crewai_flow) and the host of the webhook of the AMP dashboard.
EXTERNAL_APP_API_URL=http://localhost:8000
# EXTERNAL_APP_API_URL=https://<something>.ngrok-free.app

# =================================  CREWAI  =================================
# The CrewAI flow, deployed on CrewAI AMP (AMP dashboard: the URL and the Bearer token of the
# deployment). Only the Next.js SERVER reads these two, so the token never reaches the browser.
# The Bearer token is how WE call AMP (kickoff). It is not a webhook secret.
CREWAI_FLOW_API_URL=https://<your-flow>.crewai.com
CREWAI_FLOW_API_BEARER_TOKEN=

# The secret of the KICKOFF webhook (Webhook Streaming: the start and the end of each run). You choose it, and
# AMP sends it back as `Authorization: Bearer <secret>`. The backend must have the same CREWAI_KICKOFF_WEBHOOK_SECRET.
# It is not the secret of the HITL webhook (CREWAI_HITL_WEBHOOK_SECRET): AMP generates that one.
CREWAI_KICKOFF_WEBHOOK_SECRET=your-secret-token
