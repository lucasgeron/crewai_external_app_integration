# =================================  API  =================================
# Port of the API on your machine (only ./dev.sh reads it; with uvicorn by hand use --port).
API_PORT=8000

# Websites allowed to call the API from a browser (a JSON list).
# If you change the frontend port, change it here too.
CORS_ORIGINS=["http://localhost:3000"]

# The SQLite file (created on the first start). Optional: this is the default.
# DATABASE_URL=sqlite:///./data/external_app.db

# =================================  CREWAI AMP WEBHOOKS  =================================
# HITL webhook (human review): CrewAI AMP calls POST /hitl-webhook when a flow waits for a person.
# The secret of that webhook (`whsec_...`, generated by AMP and shown in its dashboard). AMP signs every webhook
# with it and the API refuses the ones that are not signed (HMAC-SHA256). Required for the webhook to work.
CREWAI_HITL_WEBHOOK_SECRET=

# KICKOFF webhook (Webhook Streaming): CrewAI AMP calls POST /flow-webhook when a run starts and finishes.
# You choose this secret; AMP sends it back as `Authorization: Bearer <secret>`. The frontend must have the same
# CREWAI_KICKOFF_WEBHOOK_SECRET in .env.local. Not the same as CREWAI_HITL_WEBHOOK_SECRET. Required for the runs
# to finish in the app.
CREWAI_KICKOFF_WEBHOOK_SECRET=your-secret-token
